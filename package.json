{
	"name": "better-pm",
	"version": "0.5.3",
	"description": "Better CLI for package manager operations (especially in monorepos)",
	"type": "module",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/fdarian/better-pm.git"
	},
	"packageManager": "pnpm@12.9.0",
	"bin": {
		"pm": "./bin.mjs"
	},
	"files": [
		"bin.mjs"
	],
	"imports": {
		"#src/*": "./src/*"
	},
	"scripts": {
		"format": "biome check --write",
		"check:tsc": "tsrs --noEmit",
		"build": "bun scripts/build-npm.ts",
		"docs": "pnpm --filter docs dev",
		"docs:build": "pnpm --filter docs build",
		"ci:version": "pnpm exec changeset version && pnpm install --lockfile-only",
		"ci:release": "bun run build && bun scripts/publish-npm.ts",
		"test": "vitest run"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@changesets/cli": "^2.29.8",
		"@effect/platform-bun": "4.0.0-rc.112",
		"@effect/vitest": "4.0.0-rc.112",
		"@types/bun": "latest",
		"@typescript/native-preview": "^7.0.0-dev.20260130.1",
		"effect": "4.0.0-rc.112",
		"tsrs": "0.18.0-ts7.1.0-dev.20260929",
		"typescript": "latest",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"picocolors": "^1.1.1"
	}
}
